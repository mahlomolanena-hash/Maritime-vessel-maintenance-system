# Environment / secrets — application.yml / application-dev.yml / application-prod.yml
# only ever reference secrets via ${ENV_VAR:placeholder} — never a real value — so
# they're safe to commit. application-local.yml is where real personal overrides go,
# so that one stays ignored.
.env
application-local.yml
application-local.properties

# Maven
.mvn/wrapper/maven-wrapper.jar
